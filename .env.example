# CareGap local development configuration. Copy to .env and adjust as needed.
# All values are placeholders; never commit a real .env file.

# --- Backend ---
CAREGAP_ENV=development
CAREGAP_DATABASE_URL=sqlite:///./caregap.db
CAREGAP_CORS_ORIGINS=http://localhost:3000
CAREGAP_LOG_LEVEL=INFO
CAREGAP_MAX_IMPORT_BYTES=2097152
CAREGAP_DEMO_SEED=20261024

# Optional PostgreSQL (use the Compose service or your own instance)
# CAREGAP_DATABASE_URL=postgresql+psycopg://caregap:change-me@localhost:5432/caregap

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Docker Compose (local PostgreSQL/PostGIS) ---
# Copy this file to .env and replace the placeholder before running compose.
POSTGRES_DB=caregap
POSTGRES_USER=caregap
POSTGRES_PASSWORD=change-me-local-demo
POSTGRES_PORT=5432
# Compose constructs the database URL from POSTGRES_* automatically.
# For a native backend against this database, uncomment:
# CAREGAP_DATABASE_URL=postgresql+psycopg://caregap:change-me-local-demo@localhost:5432/caregap
